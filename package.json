{
  "name": "portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"npm run server:dev\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --test tests/portfolio.test.mjs && node tests/dom.test.mjs",
    "test:unit": "node --test tests/portfolio.test.mjs",
    "test:dom": "node tests/dom.test.mjs",
    "server:dev": "cd server && npx tsx watch index.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.0",
    "nodemailer": "^10.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^6.2.4",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vercel/node": "^30.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vercel": "^65.12.1",
    "vite": "^6.0.1"
  }
}
